+LDFLAGS += -Wl,--hash-style=gnu
+
 # Nom du binaire et fichier source
 TARGET = esme-gpio-toggle
 SRC = esme-gpio-toggle.c
@@ -19,18 +22,19 @@ all: $(TARGET)
 
 # Compilation implicite
 $(TARGET): $(SRC)
-	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)
