+	@chmod 755 $(INSTALL_DIR)/bin/$(TARGET)
 	@mkdir -p $(INSTALL_DIR)/etc/init.d
-	install -m 0755 esme-gpio26-toggle $(INSTALL_DIR)/etc/init.d/esme-gpio26-toggle
+	install -m 0755 esme-gpio-toggle $(INSTALL_DIR)/etc/init.d/
+
 
 # Nettoyage
 clean:
 	rm -f $(TARGET) *.o
 
 .PHONY: all install clean
