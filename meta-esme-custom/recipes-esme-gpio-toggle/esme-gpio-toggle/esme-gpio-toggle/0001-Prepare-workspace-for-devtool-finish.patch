diff --git a/.install/etc/init.d/esme-gpio26-toggle b/.install/etc/init.d/esme-gpio26-toggle
new file mode 100755
index 0000000..8347fff
--- /dev/null
+++ b/.install/etc/init.d/esme-gpio26-toggle
@@ -0,0 +1,45 @@
+#!/bin/sh
+### BEGIN INIT INFO
+# Provides:             esme-gpio26-toggle
+# Required-Start:       $remote_fs $time
+# Required-Stop:        $remote_fs $time
+# Default-Start:        3 4 5
+# Default-Stop:         0 1 2 6
+# Short-Description:    ESME GPIO#26 toggle service
+### END INIT INFO
+
+DAEMON="/usr/bin/esme-gpio-toggle"
+PIDFILE="/var/run/esme-gpio26-toggle.pid"
+GPIO=26
+
+case "$1" in
+    start)
+        echo "Starting esme-gpio26-toggle..."
+        start-stop-daemon --start --background --make-pidfile \
+            --pidfile "$PIDFILE" --exec "$DAEMON" -- --gpio $GPIO
+        ;;
+    stop)
+        echo "Stopping esme-gpio26-toggle..."
+        start-stop-daemon --stop --pidfile "$PIDFILE" --retry 5
+        rm -f "$PIDFILE"
+        ;;
+    restart)
+        echo "Restarting esme-gpio26-toggle..."
+        $0 stop
+        sleep 1
+        $0 start
+        ;;
+    status)
+        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
+            echo "Status of esme-gpio-toggle for GPIO#26: running with PID=$(cat $PIDFILE)"
+            exit 0
+        else
+            echo "Status of esme-gpio-toggle for GPIO#26: stopped"
+            exit 1
+        fi
+        ;;
+    *)
+        echo "Usage: esme-gpio26-toggle (start | stop | restart | status )"
+        exit 2
+        ;;
+esac
