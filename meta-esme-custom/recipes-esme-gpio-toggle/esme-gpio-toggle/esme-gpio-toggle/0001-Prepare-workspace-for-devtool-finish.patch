--- a/Makefile
+++ b/Makefile
@@ -7,6 +7,9 @@ CC ?= gcc
 CFLAGS += $(shell pkg-config --cflags libgpiod)
 LDLIBS += $(shell pkg-config --libs libgpiod)
 
